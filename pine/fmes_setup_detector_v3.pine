//@version=6
// =====================================================================
// FMES — Trade Setup Detector v3 (Clean)
// Same logic as v2, but with aggressive visual hygiene:
//   • Only the MOST RECENT PSH and PSL setup is fully drawn
//   • Older setups get their lines/boxes/labels auto-deleted when a new
//     one fires in the same direction
//   • ENTER / EXIT event labels remain as small history markers
//   • Defaults to minimal display (no Fib dotted, no Prot zone box,
//     no TP1, shorter line extension)
// Result: chart shows just the active setup(s) + a clean event trail.
// =====================================================================

indicator("FMES — Trade Setup Detector v3", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ─── Inputs ──────────────────────────────────────────────────────────
grpCore = "Core"
pivotLen      = input.int(5,  "Pivot lookback",                1, 50,  group=grpCore)
sweepWindow   = input.int(20, "Max bars between sweep & BOS",  1, 100, group=grpCore)
requireVolGap = input.bool(true, "Require volume gap on BOS",        group=grpCore)

grpV3 = "v3 — Clean Display"
keepOldSetups   = input.bool(false, "Keep old setup lines on chart (legacy mode)", group=grpV3, tooltip="Off (default) = only the latest setup of each direction is drawn. Old setups auto-delete when new ones fire.")
showEnterExit   = input.bool(true,  "Show ENTER / EXIT event labels", group=grpV3)
showStatusPanel = input.bool(false, "Show status panel (top-right)",  group=grpV3)

grpDraw = "Draw layers (default: minimal)"
showOB     = input.bool(true,  "Show Order Block box",            group=grpDraw)
showLevels = input.bool(true,  "Show Entry / SL / TP lines",      group=grpDraw)
showLabels = input.bool(true,  "Show price labels",               group=grpDraw)
showFib    = input.bool(false, "Show Fibonacci dotted lines",     group=grpDraw)
showTP1    = input.bool(false, "Show TP1 (-0.27 extension) line", group=grpDraw)
showProtBox = input.bool(false, "Show purple Protected zone box", group=grpDraw)
extendBars = input.int(20, "Extend setup levels right (bars)", 0, 200, group=grpDraw)

grpM4 = "M4 — LQ+ Patterns"
showLQPlus  = input.bool(true, "Detect double/triple tops & bottoms", group=grpM4)
lqTolerance = input.float(0.3, "Equal-level tolerance (x ATR)", 0.05, 1.0, step=0.05, group=grpM4)
lqWindow    = input.int(40, "Lookback window (bars)", 5, 200, group=grpM4)

grpM5 = "M5 — HWR Dual-Limit"
enableHWR   = input.bool(true,  "Enable HWR dual-limit (Fib + OB)", group=grpM5)
hwrTargetRR = input.float(2.0,  "OB limit target R:R", 0.5, 5.0, step=0.5, group=grpM5)
trackHWR    = input.bool(false, "Track HWR (OB) limit lifecycle separately", group=grpM5)

grpColor = "Colors"
bullColor   = input.color(#26a69a, "Bullish",  group=grpColor)
bearColor   = input.color(#ef5350, "Bearish",  group=grpColor)
protBorder  = input.color(#ab47bc, "Protected border", group=grpColor)
protFill    = input.color(color.new(#ab47bc, 80), "Protected fill", group=grpColor)
entryColor  = input.color(#4caf50, "Entry (Fib 0.71)",   group=grpColor)
slColor     = input.color(#f44336, "Stop Loss (Fib 1)",  group=grpColor)
tpColor     = input.color(#00bcd4, "Take Profit",        group=grpColor)
obFill      = input.color(color.new(#ffd54f, 70), "OB fill",   group=grpColor)
obBorder    = input.color(#ffa000, "OB border",          group=grpColor)
fibColor    = input.color(color.new(#9e9e9e, 50), "Fib dotted lines", group=grpColor)
lqColor     = input.color(#fbc02d, "LQ+ pattern",        group=grpColor)
hwrColor    = input.color(#7e57c2, "HWR (OB limit)",     group=grpColor)

// ─── UDT for setup drawings (so we can delete them as a group) ───────
type Drawing
    line  entryLn
    line  slLn
    line  tpLn
    line  tp1Ln
    line  obEntryLn
    line  obTpLn
    line  fibSlLn
    line  fibEntryLn
    line  fibTpLn
    box   obBox
    box   zoneBox
    label chipLbl
    label entryLbl
    label slLbl
    label tpLbl
    label tp1Lbl
    label obEntryLbl
    label obTpLbl

clearDrawing(Drawing d) =>
    if not na(d.entryLn)
        line.delete(d.entryLn)
    if not na(d.slLn)
        line.delete(d.slLn)
    if not na(d.tpLn)
        line.delete(d.tpLn)
    if not na(d.tp1Ln)
        line.delete(d.tp1Ln)
    if not na(d.obEntryLn)
        line.delete(d.obEntryLn)
    if not na(d.obTpLn)
        line.delete(d.obTpLn)
    if not na(d.fibSlLn)
        line.delete(d.fibSlLn)
    if not na(d.fibEntryLn)
        line.delete(d.fibEntryLn)
    if not na(d.fibTpLn)
        line.delete(d.fibTpLn)
    if not na(d.obBox)
        box.delete(d.obBox)
    if not na(d.zoneBox)
        box.delete(d.zoneBox)
    if not na(d.chipLbl)
        label.delete(d.chipLbl)
    if not na(d.entryLbl)
        label.delete(d.entryLbl)
    if not na(d.slLbl)
        label.delete(d.slLbl)
    if not na(d.tpLbl)
        label.delete(d.tpLbl)
    if not na(d.tp1Lbl)
        label.delete(d.tp1Lbl)
    if not na(d.obEntryLbl)
        label.delete(d.obEntryLbl)
    if not na(d.obTpLbl)
        label.delete(d.obTpLbl)

// ─── Pivots & ATR ────────────────────────────────────────────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

atr14     = ta.atr(14)
zoneThick = atr14 * 0.15

// ─── State (M1+M2) ───────────────────────────────────────────────────
var float lastHigh    = na
var int   lastHighBar = na
var bool  bosFiredUp  = false

var float lastLow    = na
var int   lastLowBar = na
var bool  bosFiredDn = false

var float pendSwH    = na
var int   pendSwHBar = na
var bool  waitBearBOS = false

var float pendSwL    = na
var int   pendSwLBar = na
var bool  waitBullBOS = false

var array<float> recentPHPrices = array.new<float>()
var array<int>   recentPHBars   = array.new<int>()
var array<float> recentPLPrices = array.new<float>()
var array<int>   recentPLBars   = array.new<int>()

// Current drawings per direction
var Drawing curPSH = Drawing.new()
var Drawing curPSL = Drawing.new()

// Lifecycle tracking arrays
var array<float> tEntry  = array.new<float>()
var array<float> tSL     = array.new<float>()
var array<float> tTP     = array.new<float>()
var array<int>   tDir    = array.new<int>()
var array<int>   tStatus = array.new<int>()
var array<int>   tBar    = array.new<int>()
var array<int>   tKind   = array.new<int>()

addTracked(float e, float sl, float tp, int d, int kind) =>
    array.push(tEntry, e)
    array.push(tSL, sl)
    array.push(tTP, tp)
    array.push(tDir, d)
    array.push(tStatus, 0)
    array.push(tBar, bar_index)
    array.push(tKind, kind)
    if array.size(tEntry) > 100
        array.shift(tEntry)
        array.shift(tSL)
        array.shift(tTP)
        array.shift(tDir)
        array.shift(tStatus)
        array.shift(tBar)
        array.shift(tKind)

// ─── Pivot registration ──────────────────────────────────────────────
if not na(ph)
    lastHigh    := ph
    lastHighBar := bar_index - pivotLen
    bosFiredUp  := false

if not na(pl)
    lastLow    := pl
    lastLowBar := bar_index - pivotLen
    bosFiredDn := false

// ─── M4: LQ+ pattern detection ───────────────────────────────────────
checkEqualLevels(float curPrice, int curBar, array<float> prices, array<int> bars, float tol, int window) =>
    int matchCount = 0
    int firstMatchBar = 0
    if array.size(prices) > 0
        for i = 0 to array.size(prices) - 1
            prior = array.get(prices, i)
            priorBar = array.get(bars, i)
            if math.abs(curPrice - prior) <= tol and (curBar - priorBar) >= 3 and (curBar - priorBar) <= window
                matchCount := matchCount + 1
                if matchCount == 1
                    firstMatchBar := priorBar
    [matchCount, firstMatchBar]

if not na(ph) and showLQPlus
    curBarH = bar_index - pivotLen
    tolH = atr14 * lqTolerance
    [mcH, fmbH] = checkEqualLevels(ph, curBarH, recentPHPrices, recentPHBars, tolH, lqWindow)
    if mcH >= 1
        patTypeH = mcH >= 2 ? "TT" : "DT"
        line.new(fmbH, ph, curBarH, ph, color=lqColor, style=line.style_dashed, width=1)
        label.new(curBarH, ph, patTypeH, style=label.style_label_down, yloc=yloc.abovebar, color=lqColor, textcolor=color.black, size=size.tiny)
    array.push(recentPHPrices, ph)
    array.push(recentPHBars, curBarH)
    if array.size(recentPHPrices) > 30
        array.shift(recentPHPrices)
        array.shift(recentPHBars)

if not na(pl) and showLQPlus
    curBarL = bar_index - pivotLen
    tolL = atr14 * lqTolerance
    [mcL, fmbL] = checkEqualLevels(pl, curBarL, recentPLPrices, recentPLBars, tolL, lqWindow)
    if mcL >= 1
        patTypeL = mcL >= 2 ? "TT" : "DT"
        line.new(fmbL, pl, curBarL, pl, color=lqColor, style=line.style_dashed, width=1)
        label.new(curBarL, pl, patTypeL, style=label.style_label_up, yloc=yloc.belowbar, color=lqColor, textcolor=color.black, size=size.tiny)
    array.push(recentPLPrices, pl)
    array.push(recentPLBars, curBarL)
    if array.size(recentPLPrices) > 30
        array.shift(recentPLPrices)
        array.shift(recentPLBars)

// ─── Sweep ───────────────────────────────────────────────────────────
sweepUp = not na(lastHigh) and high > lastHigh and close <= lastHigh
sweepDn = not na(lastLow)  and low  < lastLow  and close >= lastLow

if sweepUp
    pendSwH     := lastHigh
    pendSwHBar  := bar_index
    waitBearBOS := true
if sweepDn
    pendSwL     := lastLow
    pendSwLBar  := bar_index
    waitBullBOS := true

// ─── BOS ─────────────────────────────────────────────────────────────
bullBOS = not na(lastHigh) and close > lastHigh and not bosFiredUp
bearBOS = not na(lastLow)  and close < lastLow  and not bosFiredDn

if bullBOS
    bosFiredUp := true
if bearBOS
    bosFiredDn := true

bullGap = high[2] < low[0]
bearGap = low[2]  > high[0]

protHighOK = waitBearBOS and bearBOS and (bar_index - pendSwHBar <= sweepWindow) and (not requireVolGap or bearGap)
protLowOK  = waitBullBOS and bullBOS and (bar_index - pendSwLBar <= sweepWindow) and (not requireVolGap or bullGap)

// ─── Setup drawing (with auto-clear of previous in same direction) ───
if protHighOK
    // Clear previous PSH if not legacy mode
    if not keepOldSetups
        clearDrawing(curPSH)
        curPSH := Drawing.new()

    swhPrice = pendSwH
    swLow    = low
    rng      = swhPrice - swLow
    entryPx  = swLow + 0.71 * rng
    slPx     = swhPrice
    tp2Px    = swLow
    tp1Px    = swLow - 0.27 * rng
    rightX   = bar_index + extendBars

    sweepBarAgo = bar_index - pendSwHBar
    obTop = high[sweepBarAgo]
    obBot = math.max(open[sweepBarAgo], close[sweepBarAgo])

    if showFib
        curPSH.fibSlLn    := line.new(pendSwHBar, slPx,    rightX, slPx,    color=fibColor, style=line.style_dotted, width=1)
        curPSH.fibEntryLn := line.new(pendSwHBar, entryPx, rightX, entryPx, color=fibColor, style=line.style_dotted, width=1)
        curPSH.fibTpLn    := line.new(pendSwHBar, tp2Px,   rightX, tp2Px,   color=fibColor, style=line.style_dotted, width=1)

    if showOB
        curPSH.obBox := box.new(pendSwHBar, obTop, rightX, obBot, bgcolor=obFill, border_color=obBorder, border_width=1)

    if showLevels
        curPSH.entryLn := line.new(bar_index, entryPx, rightX, entryPx, color=entryColor, style=line.style_solid,  width=2)
        curPSH.slLn    := line.new(bar_index, slPx,    rightX, slPx,    color=slColor,    style=line.style_solid,  width=2)
        curPSH.tpLn    := line.new(bar_index, tp2Px,   rightX, tp2Px,   color=tpColor,    style=line.style_solid,  width=2)
        if showTP1
            curPSH.tp1Ln := line.new(bar_index, tp1Px, rightX, tp1Px, color=tpColor, style=line.style_dashed, width=1)

    if showLabels
        curPSH.entryLbl := label.new(rightX, entryPx, "Entry " + str.tostring(entryPx, format.mintick), style=label.style_label_left, color=entryColor, textcolor=color.white, size=size.small)
        curPSH.slLbl    := label.new(rightX, slPx,    "SL "    + str.tostring(slPx,    format.mintick), style=label.style_label_left, color=slColor,    textcolor=color.white, size=size.small)
        curPSH.tpLbl    := label.new(rightX, tp2Px,   "TP "    + str.tostring(tp2Px,   format.mintick) + " | 2.45R", style=label.style_label_left, color=tpColor, textcolor=color.white, size=size.small)
        if showTP1
            curPSH.tp1Lbl := label.new(rightX, tp1Px, "TP1 " + str.tostring(tp1Px, format.mintick), style=label.style_label_left, color=color.new(tpColor, 30), textcolor=color.white, size=size.tiny)

    addTracked(entryPx, slPx, tp2Px, -1, 0)

    if enableHWR
        obEntryPx = obBot
        obRisk    = slPx - obEntryPx
        obTPPx    = obEntryPx - obRisk * hwrTargetRR
        curPSH.obEntryLn := line.new(bar_index, obEntryPx, rightX, obEntryPx, color=hwrColor, style=line.style_solid, width=2)
        curPSH.obTpLn    := line.new(bar_index, obTPPx,    rightX, obTPPx,    color=color.new(hwrColor, 30), style=line.style_dashed, width=1)
        if showLabels
            curPSH.obEntryLbl := label.new(rightX, obEntryPx, "OB " + str.tostring(obEntryPx, format.mintick), style=label.style_label_left, color=hwrColor, textcolor=color.white, size=size.tiny)
            curPSH.obTpLbl    := label.new(rightX, obTPPx,    "OB TP " + str.tostring(obTPPx, format.mintick), style=label.style_label_left, color=color.new(hwrColor, 30), textcolor=color.white, size=size.tiny)
        if trackHWR
            addTracked(obEntryPx, slPx, obTPPx, -1, 1)

    if showProtBox
        curPSH.zoneBox := box.new(pendSwHBar, pendSwH + zoneThick, rightX, pendSwH - zoneThick, bgcolor=protFill, border_color=protBorder, border_width=1)
    curPSH.chipLbl := label.new(pendSwHBar, pendSwH, "PSH ▼", style=label.style_label_down, yloc=yloc.abovebar, color=protBorder, textcolor=color.white, size=size.small)

    waitBearBOS := false

if protLowOK
    if not keepOldSetups
        clearDrawing(curPSL)
        curPSL := Drawing.new()

    swlPrice = pendSwL
    swHigh   = high
    rng      = swHigh - swlPrice
    entryPx  = swHigh - 0.71 * rng
    slPx     = swlPrice
    tp2Px    = swHigh
    tp1Px    = swHigh + 0.27 * rng
    rightX   = bar_index + extendBars

    sweepBarAgo = bar_index - pendSwLBar
    obTop = math.min(open[sweepBarAgo], close[sweepBarAgo])
    obBot = low[sweepBarAgo]

    if showFib
        curPSL.fibSlLn    := line.new(pendSwLBar, slPx,    rightX, slPx,    color=fibColor, style=line.style_dotted, width=1)
        curPSL.fibEntryLn := line.new(pendSwLBar, entryPx, rightX, entryPx, color=fibColor, style=line.style_dotted, width=1)
        curPSL.fibTpLn    := line.new(pendSwLBar, tp2Px,   rightX, tp2Px,   color=fibColor, style=line.style_dotted, width=1)

    if showOB
        curPSL.obBox := box.new(pendSwLBar, obTop, rightX, obBot, bgcolor=obFill, border_color=obBorder, border_width=1)

    if showLevels
        curPSL.entryLn := line.new(bar_index, entryPx, rightX, entryPx, color=entryColor, style=line.style_solid,  width=2)
        curPSL.slLn    := line.new(bar_index, slPx,    rightX, slPx,    color=slColor,    style=line.style_solid,  width=2)
        curPSL.tpLn    := line.new(bar_index, tp2Px,   rightX, tp2Px,   color=tpColor,    style=line.style_solid,  width=2)
        if showTP1
            curPSL.tp1Ln := line.new(bar_index, tp1Px, rightX, tp1Px, color=tpColor, style=line.style_dashed, width=1)

    if showLabels
        curPSL.entryLbl := label.new(rightX, entryPx, "Entry " + str.tostring(entryPx, format.mintick), style=label.style_label_left, color=entryColor, textcolor=color.white, size=size.small)
        curPSL.slLbl    := label.new(rightX, slPx,    "SL "    + str.tostring(slPx,    format.mintick), style=label.style_label_left, color=slColor,    textcolor=color.white, size=size.small)
        curPSL.tpLbl    := label.new(rightX, tp2Px,   "TP "    + str.tostring(tp2Px,   format.mintick) + " | 2.45R", style=label.style_label_left, color=tpColor, textcolor=color.white, size=size.small)
        if showTP1
            curPSL.tp1Lbl := label.new(rightX, tp1Px, "TP1 " + str.tostring(tp1Px, format.mintick), style=label.style_label_left, color=color.new(tpColor, 30), textcolor=color.white, size=size.tiny)

    addTracked(entryPx, slPx, tp2Px, 1, 0)

    if enableHWR
        obEntryPx = obTop
        obRisk    = obEntryPx - slPx
        obTPPx    = obEntryPx + obRisk * hwrTargetRR
        curPSL.obEntryLn := line.new(bar_index, obEntryPx, rightX, obEntryPx, color=hwrColor, style=line.style_solid, width=2)
        curPSL.obTpLn    := line.new(bar_index, obTPPx,    rightX, obTPPx,    color=color.new(hwrColor, 30), style=line.style_dashed, width=1)
        if showLabels
            curPSL.obEntryLbl := label.new(rightX, obEntryPx, "OB " + str.tostring(obEntryPx, format.mintick), style=label.style_label_left, color=hwrColor, textcolor=color.white, size=size.tiny)
            curPSL.obTpLbl    := label.new(rightX, obTPPx,    "OB TP " + str.tostring(obTPPx, format.mintick), style=label.style_label_left, color=color.new(hwrColor, 30), textcolor=color.white, size=size.tiny)
        if trackHWR
            addTracked(obEntryPx, slPx, obTPPx, 1, 1)

    if showProtBox
        curPSL.zoneBox := box.new(pendSwLBar, pendSwL + zoneThick, rightX, pendSwL - zoneThick, bgcolor=protFill, border_color=protBorder, border_width=1)
    curPSL.chipLbl := label.new(pendSwLBar, pendSwL, "PSL ▲", style=label.style_label_up, yloc=yloc.belowbar, color=protBorder, textcolor=color.white, size=size.small)

    waitBullBOS := false

// ─── Stale sweep cleanup ─────────────────────────────────────────────
if waitBearBOS and (bar_index - pendSwHBar > sweepWindow)
    waitBearBOS := false
if waitBullBOS and (bar_index - pendSwLBar > sweepWindow)
    waitBullBOS := false

// ─── Lifecycle (ENTER / EXIT event labels) ───────────────────────────
var bool evtEnter = false
var bool evtTP    = false
var bool evtSL    = false
evtEnter := false
evtTP    := false
evtSL    := false

if showEnterExit and array.size(tEntry) > 0
    for i = 0 to array.size(tEntry) - 1
        st = array.get(tStatus, i)
        if st >= 2
            continue
        e  = array.get(tEntry, i)
        sl = array.get(tSL,    i)
        tp = array.get(tTP,    i)
        d  = array.get(tDir,   i)
        if st == 0
            triggered = (d == 1 and low <= e) or (d == -1 and high >= e)
            if triggered
                array.set(tStatus, i, 1)
                evtEnter := true
                label.new(bar_index, e,
                     d == 1 ? "🟢 ENTER L" : "🔴 ENTER S",
                     style=d == 1 ? label.style_label_up : label.style_label_down,
                     yloc=d == 1 ? yloc.belowbar : yloc.abovebar,
                     color=entryColor, textcolor=color.white, size=size.small)
        if st == 1
            won  = (d == 1 and high >= tp) or (d == -1 and low <= tp)
            lost = (d == 1 and low  <= sl) or (d == -1 and high >= sl)
            if won
                array.set(tStatus, i, 2)
                evtTP := true
                label.new(bar_index, tp, "✅ TP",
                     style=d == 1 ? label.style_label_down : label.style_label_up,
                     yloc=d == 1 ? yloc.abovebar : yloc.belowbar,
                     color=tpColor, textcolor=color.white, size=size.small)
                // Clear the setup drawing once it's complete
                if not keepOldSetups
                    if d == -1
                        clearDrawing(curPSH)
                        curPSH := Drawing.new()
                    else
                        clearDrawing(curPSL)
                        curPSL := Drawing.new()
            else if lost
                array.set(tStatus, i, 3)
                evtSL := true
                label.new(bar_index, sl, "❌ SL",
                     style=d == 1 ? label.style_label_up : label.style_label_down,
                     yloc=d == 1 ? yloc.belowbar : yloc.abovebar,
                     color=slColor, textcolor=color.white, size=size.small)
                if not keepOldSetups
                    if d == -1
                        clearDrawing(curPSH)
                        curPSH := Drawing.new()
                    else
                        clearDrawing(curPSL)
                        curPSL := Drawing.new()

// ─── Status panel ────────────────────────────────────────────────────
var table statusPanel = table.new(position.top_right, 2, 6,
     bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)

if barstate.islast and showStatusPanel
    pending = 0
    live    = 0
    won     = 0
    lost    = 0
    if array.size(tStatus) > 0
        for i = 0 to array.size(tStatus) - 1
            st = array.get(tStatus, i)
            if st == 0
                pending := pending + 1
            else if st == 1
                live := live + 1
            else if st == 2
                won := won + 1
            else if st == 3
                lost := lost + 1
    totalClosed = won + lost
    winRate = totalClosed > 0 ? math.round(100.0 * won / totalClosed) : 0

    table.cell(statusPanel, 0, 0, "FMES v3",   bgcolor=color.new(color.gray, 30), text_color=color.yellow, text_size=size.small)
    table.cell(statusPanel, 1, 0, "Count",     bgcolor=color.new(color.gray, 30), text_color=color.yellow, text_size=size.small)
    table.cell(statusPanel, 0, 1, "⏳ Pending", text_color=color.silver, text_size=size.small)
    table.cell(statusPanel, 1, 1, str.tostring(pending), text_color=color.silver, text_size=size.small)
    table.cell(statusPanel, 0, 2, "🔵 Live",    text_color=color.aqua,   text_size=size.small)
    table.cell(statusPanel, 1, 2, str.tostring(live), text_color=color.aqua, text_size=size.small)
    table.cell(statusPanel, 0, 3, "✅ Won",     text_color=color.lime,   text_size=size.small)
    table.cell(statusPanel, 1, 3, str.tostring(won), text_color=color.lime, text_size=size.small)
    table.cell(statusPanel, 0, 4, "❌ Lost",    text_color=color.red,    text_size=size.small)
    table.cell(statusPanel, 1, 4, str.tostring(lost), text_color=color.red, text_size=size.small)
    table.cell(statusPanel, 0, 5, "📊 Win Rate", text_color=color.orange, text_size=size.small)
    table.cell(statusPanel, 1, 5, str.tostring(winRate) + "%", text_color=color.orange, text_size=size.small)

// ─── Alerts ──────────────────────────────────────────────────────────
alertcondition(protHighOK, "Short Setup Ready",  "FMES: SHORT setup ready")
alertcondition(protLowOK,  "Long Setup Ready",   "FMES: LONG setup ready")
alertcondition(evtEnter,   "Entry Triggered",    "FMES: ENTER — limit filled")
alertcondition(evtTP,      "TP Hit",             "FMES: TP HIT — close winner")
alertcondition(evtSL,      "SL Hit",             "FMES: SL HIT — close loser")
