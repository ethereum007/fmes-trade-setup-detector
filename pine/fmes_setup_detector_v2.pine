//@version=6
// =====================================================================
// FMES — Trade Setup Detector v2 (Enter/Exit Tracking)
// Extends M5 with real-time setup lifecycle:
//   • Pending → Live (entry fills)
//   • Live → Won (TP) or Lost (SL)
// Drops 🟢/🔴 ENTER and ✅/❌ EXIT labels at the actual bars.
// Adds a Status Panel and alerts for each lifecycle event.
// =====================================================================

indicator("FMES — Trade Setup Detector (Enter/Exit)", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ─── Inputs (M1-M5 inherited) ────────────────────────────────────────
grpCore = "Core"
pivotLen      = input.int(5,  "Pivot lookback",                1, 50,  group=grpCore)
sweepWindow   = input.int(20, "Max bars between sweep & BOS",  1, 100, group=grpCore)
requireVolGap = input.bool(true, "Require volume gap on BOS",        group=grpCore)

grpM3 = "M3 — Trade Setup"
showFib    = input.bool(true, "Show Fibonacci dotted lines",       group=grpM3)
showOB     = input.bool(true, "Show Order Block box",              group=grpM3)
showLevels = input.bool(true, "Show Entry / SL / TP lines",        group=grpM3)
showLabels = input.bool(true, "Show price labels",                 group=grpM3)
extendBars = input.int(60, "Extend setup levels right (bars)", 0, 300, group=grpM3)

grpM4 = "M4 — LQ+ Patterns"
showLQPlus  = input.bool(true, "Detect double/triple tops & bottoms", group=grpM4)
lqTolerance = input.float(0.3, "Equal-level tolerance (x ATR)", 0.05, 1.0, step=0.05, group=grpM4)
lqWindow    = input.int(40, "Lookback window (bars)", 5, 200, group=grpM4)

grpM5 = "M5 — HWR Dual-Limit"
enableHWR   = input.bool(true, "Enable HWR dual-limit (Fib + OB)", group=grpM5)
hwrTargetRR = input.float(2.0, "OB limit target R:R", 0.5, 5.0, step=0.5, group=grpM5)

grpV2 = "v2 — Enter/Exit Tracking"
showEnterExit   = input.bool(true,  "Show ENTER / EXIT labels",       group=grpV2)
showStatusPanel = input.bool(true,  "Show status panel (top-right)",  group=grpV2)
trackHWR        = input.bool(false, "Also track HWR (OB) limit lifecycle", group=grpV2,
     tooltip="If on, the OB limit also gets ENTER/EXIT tracking. Off by default to avoid label clutter — track only the main Fib limit.")

grpDbg = "Debug / Layer toggles"
showProtZones = input.bool(true,  "Show M2 Protected zones (PSH/PSL)", group=grpDbg)
showVolGaps   = input.bool(false, "Show volume gap boxes",             group=grpDbg)
debugMode     = input.bool(false, "Show raw M1 markers",               group=grpDbg)

grpColor = "Colors"
bullColor   = input.color(#26a69a, "Bullish",  group=grpColor)
bearColor   = input.color(#ef5350, "Bearish",  group=grpColor)
sweepColor  = input.color(#ffa726, "Sweep",    group=grpColor)
protBorder  = input.color(#ab47bc, "Protected border", group=grpColor)
protFill    = input.color(color.new(#ab47bc, 80), "Protected fill", group=grpColor)
volGapFill  = input.color(color.new(#42a5f5, 75), "Volume gap fill", group=grpColor)
entryColor  = input.color(#4caf50, "Entry (Fib 0.71)",   group=grpColor)
slColor     = input.color(#f44336, "Stop Loss (Fib 1)",  group=grpColor)
tpColor     = input.color(#00bcd4, "Take Profit",        group=grpColor)
obFill      = input.color(color.new(#ffd54f, 70), "OB fill",   group=grpColor)
obBorder    = input.color(#ffa000, "OB border",          group=grpColor)
fibColor    = input.color(color.new(#9e9e9e, 50), "Fib dotted lines", group=grpColor)
lqColor     = input.color(#fbc02d, "LQ+ pattern",        group=grpColor)
hwrColor    = input.color(#7e57c2, "HWR (OB limit)",     group=grpColor)

// ─── Pivots & ATR ────────────────────────────────────────────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

atr14     = ta.atr(14)
zoneThick = atr14 * 0.15

// ─── State (M1+M2) ───────────────────────────────────────────────────
var float lastHigh    = na
var int   lastHighBar = na
var bool  bosFiredUp  = false

var float lastLow    = na
var int   lastLowBar = na
var bool  bosFiredDn = false

var float pendSwH    = na
var int   pendSwHBar = na
var bool  waitBearBOS = false

var float pendSwL    = na
var int   pendSwLBar = na
var bool  waitBullBOS = false

var array<float> recentPHPrices = array.new<float>()
var array<int>   recentPHBars   = array.new<int>()
var array<float> recentPLPrices = array.new<float>()
var array<int>   recentPLBars   = array.new<int>()

// ─── v2: Setup lifecycle tracking arrays ─────────────────────────────
// status: 0=pending, 1=live, 2=won (TP hit), 3=lost (SL hit)
// kind:   0=Fib limit, 1=OB limit
var array<float> tEntry  = array.new<float>()
var array<float> tSL     = array.new<float>()
var array<float> tTP     = array.new<float>()
var array<int>   tDir    = array.new<int>()    // 1=long, -1=short
var array<int>   tStatus = array.new<int>()
var array<int>   tBar    = array.new<int>()
var array<int>   tKind   = array.new<int>()

addTracked(e, sl, tp, d, kind) =>
    array.push(tEntry, e)
    array.push(tSL, sl)
    array.push(tTP, tp)
    array.push(tDir, d)
    array.push(tStatus, 0)
    array.push(tBar, bar_index)
    array.push(tKind, kind)
    // Cap at 100 tracked setups (oldest drops out)
    if array.size(tEntry) > 100
        array.shift(tEntry)
        array.shift(tSL)
        array.shift(tTP)
        array.shift(tDir)
        array.shift(tStatus)
        array.shift(tBar)
        array.shift(tKind)

// ─── Pivot registration ──────────────────────────────────────────────
if not na(ph)
    lastHigh    := ph
    lastHighBar := bar_index - pivotLen
    bosFiredUp  := false
    if debugMode
        label.new(lastHighBar, ph, "H", style=label.style_label_down, yloc=yloc.abovebar, color=color.new(bullColor, 80), textcolor=color.white, size=size.tiny)

if not na(pl)
    lastLow    := pl
    lastLowBar := bar_index - pivotLen
    bosFiredDn := false
    if debugMode
        label.new(lastLowBar, pl, "L", style=label.style_label_up, yloc=yloc.belowbar, color=color.new(bearColor, 80), textcolor=color.white, size=size.tiny)

// ─── M4: LQ+ pattern detection ───────────────────────────────────────
checkEqualLevels(curPrice, curBar, prices, bars, tol, window) =>
    matchCount = 0
    firstMatchBar = 0
    if array.size(prices) > 0
        for i = 0 to array.size(prices) - 1
            prior = array.get(prices, i)
            priorBar = array.get(bars, i)
            if math.abs(curPrice - prior) <= tol and (curBar - priorBar) >= 3 and (curBar - priorBar) <= window
                matchCount := matchCount + 1
                if matchCount == 1
                    firstMatchBar := priorBar
    [matchCount, firstMatchBar]

if not na(ph) and showLQPlus
    curBarH = bar_index - pivotLen
    tolH = atr14 * lqTolerance
    [mcH, fmbH] = checkEqualLevels(ph, curBarH, recentPHPrices, recentPHBars, tolH, lqWindow)
    if mcH >= 1
        patTypeH = mcH >= 2 ? "TT" : "DT"
        line.new(fmbH, ph, curBarH, ph, color=lqColor, style=line.style_dashed, width=1)
        label.new(curBarH, ph, patTypeH, style=label.style_label_down, yloc=yloc.abovebar, color=lqColor, textcolor=color.black, size=size.tiny)
    array.push(recentPHPrices, ph)
    array.push(recentPHBars, curBarH)
    if array.size(recentPHPrices) > 30
        array.shift(recentPHPrices)
        array.shift(recentPHBars)

if not na(pl) and showLQPlus
    curBarL = bar_index - pivotLen
    tolL = atr14 * lqTolerance
    [mcL, fmbL] = checkEqualLevels(pl, curBarL, recentPLPrices, recentPLBars, tolL, lqWindow)
    if mcL >= 1
        patTypeL = mcL >= 2 ? "TT" : "DT"
        line.new(fmbL, pl, curBarL, pl, color=lqColor, style=line.style_dashed, width=1)
        label.new(curBarL, pl, patTypeL, style=label.style_label_up, yloc=yloc.belowbar, color=lqColor, textcolor=color.black, size=size.tiny)
    array.push(recentPLPrices, pl)
    array.push(recentPLBars, curBarL)
    if array.size(recentPLPrices) > 30
        array.shift(recentPLPrices)
        array.shift(recentPLBars)

// ─── Wick sweep ──────────────────────────────────────────────────────
sweepUp = not na(lastHigh) and high > lastHigh and close <= lastHigh
sweepDn = not na(lastLow)  and low  < lastLow  and close >= lastLow

if sweepUp
    pendSwH     := lastHigh
    pendSwHBar  := bar_index
    waitBearBOS := true

if sweepDn
    pendSwL     := lastLow
    pendSwLBar  := bar_index
    waitBullBOS := true

// ─── BOS ─────────────────────────────────────────────────────────────
bullBOS = not na(lastHigh) and close > lastHigh and not bosFiredUp
bearBOS = not na(lastLow)  and close < lastLow  and not bosFiredDn

if bullBOS
    bosFiredUp := true
if bearBOS
    bosFiredDn := true

bullGap = high[2] < low[0]
bearGap = low[2]  > high[0]

// ─── Protected confirmation ──────────────────────────────────────────
protHighOK = waitBearBOS and bearBOS and (bar_index - pendSwHBar <= sweepWindow) and (not requireVolGap or bearGap)
protLowOK  = waitBullBOS and bullBOS and (bar_index - pendSwLBar <= sweepWindow) and (not requireVolGap or bullGap)

// ─── M3 + M5: draw setup, register for tracking ──────────────────────
if protHighOK
    swhPrice = pendSwH
    swLow    = low
    rng      = swhPrice - swLow
    entryPx  = swLow + 0.71 * rng
    slPx     = swhPrice
    tp2Px    = swLow
    tp1Px    = swLow - 0.27 * rng
    rightX   = bar_index + extendBars

    sweepBarAgo = bar_index - pendSwHBar
    obTop = high[sweepBarAgo]
    obBot = math.max(open[sweepBarAgo], close[sweepBarAgo])

    if showFib
        line.new(pendSwHBar, slPx,    rightX, slPx,    color=fibColor, style=line.style_dotted, width=1)
        line.new(pendSwHBar, entryPx, rightX, entryPx, color=fibColor, style=line.style_dotted, width=1)
        line.new(pendSwHBar, tp2Px,   rightX, tp2Px,   color=fibColor, style=line.style_dotted, width=1)

    if showOB
        box.new(pendSwHBar, obTop, rightX, obBot, bgcolor=obFill, border_color=obBorder, border_width=1)

    if showLevels
        line.new(bar_index, entryPx, rightX, entryPx, color=entryColor, style=line.style_solid,  width=2)
        line.new(bar_index, slPx,    rightX, slPx,    color=slColor,    style=line.style_solid,  width=2)
        line.new(bar_index, tp1Px,   rightX, tp1Px,   color=tpColor,    style=line.style_dashed, width=1)
        line.new(bar_index, tp2Px,   rightX, tp2Px,   color=tpColor,    style=line.style_solid,  width=2)

    if showLabels
        label.new(rightX, entryPx, "Entry " + str.tostring(entryPx, format.mintick), style=label.style_label_left, color=entryColor, textcolor=color.white, size=size.small)
        label.new(rightX, slPx,    "SL "    + str.tostring(slPx,    format.mintick), style=label.style_label_left, color=slColor,    textcolor=color.white, size=size.small)
        label.new(rightX, tp2Px,   "TP "    + str.tostring(tp2Px,   format.mintick) + "  |  2.45R", style=label.style_label_left, color=tpColor, textcolor=color.white, size=size.small)
        label.new(rightX, tp1Px,   "TP1 "   + str.tostring(tp1Px,   format.mintick) + " (-0.27)",   style=label.style_label_left, color=color.new(tpColor, 30), textcolor=color.white, size=size.tiny)

    // Register Fib limit for lifecycle tracking
    addTracked(entryPx, slPx, tp2Px, -1, 0)

    if enableHWR
        obEntryPx = obBot
        obRisk    = slPx - obEntryPx
        obTPPx    = obEntryPx - obRisk * hwrTargetRR
        line.new(bar_index, obEntryPx, rightX, obEntryPx, color=hwrColor, style=line.style_solid, width=2)
        line.new(bar_index, obTPPx,    rightX, obTPPx,    color=color.new(hwrColor, 30), style=line.style_dashed, width=1)
        if showLabels
            label.new(rightX, obEntryPx, "OB Entry " + str.tostring(obEntryPx, format.mintick), style=label.style_label_left, color=hwrColor, textcolor=color.white, size=size.tiny)
            label.new(rightX, obTPPx,    "OB TP "    + str.tostring(obTPPx,    format.mintick) + " (1:" + str.tostring(hwrTargetRR, "#.#") + ")", style=label.style_label_left, color=color.new(hwrColor, 30), textcolor=color.white, size=size.tiny)
        if trackHWR
            addTracked(obEntryPx, slPx, obTPPx, -1, 1)

    if showProtZones
        box.new(pendSwHBar, pendSwH + zoneThick, rightX, pendSwH - zoneThick, bgcolor=protFill, border_color=protBorder, border_width=1)
        label.new(pendSwHBar, pendSwH, "PSH (short)", style=label.style_label_down, yloc=yloc.abovebar, color=protBorder, textcolor=color.white, size=size.small)

    waitBearBOS := false

if protLowOK
    swlPrice = pendSwL
    swHigh   = high
    rng      = swHigh - swlPrice
    entryPx  = swHigh - 0.71 * rng
    slPx     = swlPrice
    tp2Px    = swHigh
    tp1Px    = swHigh + 0.27 * rng
    rightX   = bar_index + extendBars

    sweepBarAgo = bar_index - pendSwLBar
    obTop = math.min(open[sweepBarAgo], close[sweepBarAgo])
    obBot = low[sweepBarAgo]

    if showFib
        line.new(pendSwLBar, slPx,    rightX, slPx,    color=fibColor, style=line.style_dotted, width=1)
        line.new(pendSwLBar, entryPx, rightX, entryPx, color=fibColor, style=line.style_dotted, width=1)
        line.new(pendSwLBar, tp2Px,   rightX, tp2Px,   color=fibColor, style=line.style_dotted, width=1)

    if showOB
        box.new(pendSwLBar, obTop, rightX, obBot, bgcolor=obFill, border_color=obBorder, border_width=1)

    if showLevels
        line.new(bar_index, entryPx, rightX, entryPx, color=entryColor, style=line.style_solid,  width=2)
        line.new(bar_index, slPx,    rightX, slPx,    color=slColor,    style=line.style_solid,  width=2)
        line.new(bar_index, tp1Px,   rightX, tp1Px,   color=tpColor,    style=line.style_dashed, width=1)
        line.new(bar_index, tp2Px,   rightX, tp2Px,   color=tpColor,    style=line.style_solid,  width=2)

    if showLabels
        label.new(rightX, entryPx, "Entry " + str.tostring(entryPx, format.mintick), style=label.style_label_left, color=entryColor, textcolor=color.white, size=size.small)
        label.new(rightX, slPx,    "SL "    + str.tostring(slPx,    format.mintick), style=label.style_label_left, color=slColor,    textcolor=color.white, size=size.small)
        label.new(rightX, tp2Px,   "TP "    + str.tostring(tp2Px,   format.mintick) + "  |  2.45R", style=label.style_label_left, color=tpColor, textcolor=color.white, size=size.small)
        label.new(rightX, tp1Px,   "TP1 "   + str.tostring(tp1Px,   format.mintick) + " (-0.27)",   style=label.style_label_left, color=color.new(tpColor, 30), textcolor=color.white, size=size.tiny)

    addTracked(entryPx, slPx, tp2Px, 1, 0)

    if enableHWR
        obEntryPx = obTop
        obRisk    = obEntryPx - slPx
        obTPPx    = obEntryPx + obRisk * hwrTargetRR
        line.new(bar_index, obEntryPx, rightX, obEntryPx, color=hwrColor, style=line.style_solid, width=2)
        line.new(bar_index, obTPPx,    rightX, obTPPx,    color=color.new(hwrColor, 30), style=line.style_dashed, width=1)
        if showLabels
            label.new(rightX, obEntryPx, "OB Entry " + str.tostring(obEntryPx, format.mintick), style=label.style_label_left, color=hwrColor, textcolor=color.white, size=size.tiny)
            label.new(rightX, obTPPx,    "OB TP "    + str.tostring(obTPPx,    format.mintick) + " (1:" + str.tostring(hwrTargetRR, "#.#") + ")", style=label.style_label_left, color=color.new(hwrColor, 30), textcolor=color.white, size=size.tiny)
        if trackHWR
            addTracked(obEntryPx, slPx, obTPPx, 1, 1)

    if showProtZones
        box.new(pendSwLBar, pendSwL + zoneThick, rightX, pendSwL - zoneThick, bgcolor=protFill, border_color=protBorder, border_width=1)
        label.new(pendSwLBar, pendSwL, "PSL (long)", style=label.style_label_up, yloc=yloc.belowbar, color=protBorder, textcolor=color.white, size=size.small)

    waitBullBOS := false

// ─── Volume gap visualization (debug) ────────────────────────────────
if showVolGaps
    if bullBOS and bullGap
        box.new(bar_index - 2, low[0], bar_index, high[2], bgcolor=volGapFill, border_color=color.new(#42a5f5, 30), border_width=1)
    if bearBOS and bearGap
        box.new(bar_index - 2, low[2], bar_index, high[0], bgcolor=volGapFill, border_color=color.new(#42a5f5, 30), border_width=1)

// ─── Stale sweep cleanup ─────────────────────────────────────────────
if waitBearBOS and (bar_index - pendSwHBar > sweepWindow)
    waitBearBOS := false
if waitBullBOS and (bar_index - pendSwLBar > sweepWindow)
    waitBullBOS := false

// ─── v2: Lifecycle evaluation (every bar) ────────────────────────────
var bool evtEnter = false
var bool evtTP    = false
var bool evtSL    = false
evtEnter := false
evtTP    := false
evtSL    := false

if showEnterExit and array.size(tEntry) > 0
    for i = 0 to array.size(tEntry) - 1
        st = array.get(tStatus, i)
        if st >= 2
            continue
        e  = array.get(tEntry, i)
        sl = array.get(tSL,    i)
        tp = array.get(tTP,    i)
        d  = array.get(tDir,   i)
        k  = array.get(tKind,  i)
        kindStr = k == 0 ? "" : " (OB)"

        if st == 0
            // Pending → Live
            triggered = (d == 1 and low <= e) or (d == -1 and high >= e)
            if triggered
                array.set(tStatus, i, 1)
                evtEnter := true
                txt = (d == 1 ? "🟢 ENTER LONG" : "🔴 ENTER SHORT") + kindStr
                label.new(bar_index, e, txt,
                     style=d == 1 ? label.style_label_up : label.style_label_down,
                     yloc=d == 1 ? yloc.belowbar : yloc.abovebar,
                     color=entryColor, textcolor=color.white, size=size.normal)

        if st == 1
            won  = (d == 1 and high >= tp) or (d == -1 and low <= tp)
            lost = (d == 1 and low  <= sl) or (d == -1 and high >= sl)
            if won
                array.set(tStatus, i, 2)
                evtTP := true
                label.new(bar_index, tp,
                     "✅ TP HIT — EXIT (+R)" + kindStr,
                     style=d == 1 ? label.style_label_down : label.style_label_up,
                     yloc=d == 1 ? yloc.abovebar : yloc.belowbar,
                     color=tpColor, textcolor=color.white, size=size.normal)
            else if lost
                array.set(tStatus, i, 3)
                evtSL := true
                label.new(bar_index, sl,
                     "❌ SL HIT — EXIT (-R)" + kindStr,
                     style=d == 1 ? label.style_label_up : label.style_label_down,
                     yloc=d == 1 ? yloc.belowbar : yloc.abovebar,
                     color=slColor, textcolor=color.white, size=size.normal)

// ─── v2: Status panel (top-right) ────────────────────────────────────
var table statusPanel = table.new(position.top_right, 2, 6,
     bgcolor=color.new(color.black, 80),
     border_color=color.gray, border_width=1,
     frame_color=color.gray, frame_width=1)

if barstate.islast and showStatusPanel
    pending = 0
    live    = 0
    won     = 0
    lost    = 0
    if array.size(tStatus) > 0
        for i = 0 to array.size(tStatus) - 1
            st = array.get(tStatus, i)
            if st == 0
                pending := pending + 1
            else if st == 1
                live := live + 1
            else if st == 2
                won := won + 1
            else if st == 3
                lost := lost + 1
    totalClosed = won + lost
    winRate = totalClosed > 0 ? math.round(100.0 * won / totalClosed) : 0

    table.cell(statusPanel, 0, 0, "FMES Status", bgcolor=color.new(color.gray, 30), text_color=color.yellow, text_size=size.small)
    table.cell(statusPanel, 1, 0, "Count",      bgcolor=color.new(color.gray, 30), text_color=color.yellow, text_size=size.small)
    table.cell(statusPanel, 0, 1, "⏳ Pending", text_color=color.silver, text_size=size.small)
    table.cell(statusPanel, 1, 1, str.tostring(pending), text_color=color.silver, text_size=size.small)
    table.cell(statusPanel, 0, 2, "🔵 Live",    text_color=color.aqua,   text_size=size.small)
    table.cell(statusPanel, 1, 2, str.tostring(live), text_color=color.aqua, text_size=size.small)
    table.cell(statusPanel, 0, 3, "✅ Won",     text_color=color.lime,   text_size=size.small)
    table.cell(statusPanel, 1, 3, str.tostring(won), text_color=color.lime, text_size=size.small)
    table.cell(statusPanel, 0, 4, "❌ Lost",    text_color=color.red,    text_size=size.small)
    table.cell(statusPanel, 1, 4, str.tostring(lost), text_color=color.red, text_size=size.small)
    table.cell(statusPanel, 0, 5, "📊 Win Rate", text_color=color.orange, text_size=size.small)
    table.cell(statusPanel, 1, 5, str.tostring(winRate) + "%", text_color=color.orange, text_size=size.small)

// ─── Alerts ──────────────────────────────────────────────────────────
alertcondition(protHighOK, "Short Setup Ready",   "FMES: SHORT setup ready — Entry / SL / TP / OB plotted on chart")
alertcondition(protLowOK,  "Long Setup Ready",    "FMES: LONG setup ready — Entry / SL / TP / OB plotted on chart")
alertcondition(evtEnter,   "Entry Triggered",     "FMES: ENTER — limit order filled, position is now live")
alertcondition(evtTP,      "TP Hit — Exit Win",   "FMES: TP HIT — close position with profit")
alertcondition(evtSL,      "SL Hit — Exit Loss",  "FMES: SL HIT — close position with loss")
